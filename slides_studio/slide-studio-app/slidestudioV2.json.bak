                "text": "{\n  \"slideComponent\": {\n    \"x\": 100,\n    \"y\": 100,\n    \"scaleX\": 0.4,\n    \"scaleY\": 0.4,\n    \"style\": {\n      \"borderRadius\": \"10px\",\n      \"boxShadow\": \"0 20px 50px rgba(0,0,0,0.6)\"\n    }\n  },\n  \"cameraComponent\": {\n    \"path\": \"pulsating-circle\",\n    \"style\": {\n      \"filter\": \"drop-shadow(0 0 10px white)\"\n    }\n  },\n  \"moveTransition\": {\n    \"sources\": [\"Main Camera\"],\n\"delay\": 0,\n    \"duration\": 700,\n    \"steps\": 20,\n    \"ease\": \"bounce\"\n  }\n}"
            },
