            "settings": {
                "font": {
                    "face": "Helvetica",
                    "style": "Regular",
                    "size": 9,
                    "flags": 0
                },
                "text": "{\n  \"test1\": {\n    \"5e8fccbdd052e75316a4b8b6869572b5\": \"Scene Full Screen\",\n    \"993904a8df1ddc51cc1bbb7ee87f8cad\": \"\",\n    \"9020d96b039d074f4213cc9fd2dda375\": \"Scene Over the Shoulder round\",\n    \"d2d8b8b97cc62a680151ffbcdcfd7aff\": \"Scene Over the Shoulder\",\n    \"07e7afbcaa4341c44e5c756d74cf1ada\": \"\",\n    \"ef1f9f9580026744b9b5b15cac438944\": \"\",\n    \"61e7453562b301297994603be10b61e2\": \"Scene Full Screen\",\n    \"6feefa85c8d21ce09758d0de01b4b6e6\": \"\",\n    \"439aa00346f2cb019cdaa2ae92cf994f\": \"\",\n    \"234630ccd0d9cba454c725b24e243dc3\": \"\",\n    \"655b2b68e95df103d8d5633bd9f5ed13\": \"Scene Over the Shoulder\",\n    \"c3dc484178939d752363ba2431d1fbb5\": \"\",\n    \"4db595e5c7c496741f815d28d64620cf\": \"\",\n    \"d84c4d25d1e7d7c8c88ac5a3e94c87d2\": \"\",\n    \"17a629b1dc3e85a86b4f6d9483734e91\": \"\",\n    \"9a8202c2384dc5f720708d4f71bb813b\": \"\",\n    \"fc4bdf7cdade7e148024148357c3fa5c\": \"\",\n    \"c7e3f7e5d4078b88f39d6da8ede9f48a\": \"\",\n    \"446ed9587ace9f292e054051d865eb58\": \"Scene Slides over Camera\",\n    \"86a49c9c1f2b1ad2ac1a4e14d2152dac\": \"\",\n    \"cd545e4696a3120bb29aaf1ad30074fa\": \"\",\n    \"2e5ae78cfe62f86bebc6021fc9fa786b\": \"\",\n    \"3f34ead90d17d513d394617384ba55ea\": \"\",\n    \"2288c50675af08495bceed789fb8c691\": \"\",\n    \"9b4505cf7cadb2d74b4830b0121fe552\": \"\",\n    \"eaf4deac3c6fe8769cf7bf01c5bb658a\": \"\",\n    \"abc6e6d2b40b280f216921f9b09febc2\": \"\",\n    \"5268e849b3e2c51175d0eeece3ee1946\": \"\",\n    \"6540cf68d4894e85d2ebcae88408d2db\": \"\",\n    \"c6b487b360d93385af4e2fe70dfe5561\": \"\",\n    \"6372558427cdd590523ac4ce88d8e0f7\": \"\",\n    \"40b6956fae2414e0145d69ce83e89f0e\": \"\",\n    \"22c936b2a2fe1d17199f15a2a3678f67\": \"\",\n    \"8891a032e93ad5805ad14ffeca4277d9\": \"\",\n    \"3f303a789f76731324b04b4ec2c9c5d7\": \"\",\n    \"b6670de3b4e24193642a1924c6085253\": \"\",\n    \"e8d1f318519810de1559e8addcc53d32\": \"\",\n    \"e12d39bb34d731c3fd97e06dc961f3b0\": \"\",\n    \"23775243c6ce3b60c8459a617c9918cc\": \"\",\n    \"8c49c80941954c9ae35c8de8f869363a\": \"\",\n    \"0f9c623efae8e91f904f0b8f5364a4fe\": \"\",\n    \"9def920ebd8ce0a9d750fb19c2181ad5\": \"\",\n    \"2248aefaf87ae9308b3050272b8cb779\": \"\",\n    \"1bcec5915cde5007b854531da05ed72c\": \"\",\n    \"e8625e65bc803c788ae7ebe174b9bfff\": \"\",\n    \"941b251c57e0ddf4851ae85788c59134\": \"\",\n    \"bdac17c30dccc9f2164589ec664bdd5f\": \"\",\n    \"513f84c8791993e61edb5ffa7290d22d\": \"\",\n    \"cfdda717e5090dbeca57da3e65602176\": \"\",\n    \"9831ae4dabc0f839e1300d0c8f93d4b4\": \"\",\n    \"0434816d47916724248404867aeca064\": \"\",\n    \"409167200a9b795810d16fe211384c25\": \"\",\n    \"a10dca12b6332d1d61414d46eebcc714\": \"\",\n    \"14d03bb1e0749e98e648225eec8397d1\": \"\",\n    \"92b28ae2dade716b7f1eb17ea349ae30\": \"\",\n    \"e151e3c00899ebfaaa33ffb112cd5df2\": \"\",\n    \"9ec400a866b759707dcd9a4809f06b96\": \"\",\n    \"e8928fa3b7d2a0de248157c557ae688d\": \"\"\n  },\n  \"slides_demo_deck\": {\n    \"settings\": {\n      \"controls\": false,\n      \"progress\": false\n    },\n    \"slideScenes\": {\n      \"5e8fccbdd052e75316a4b8b6869572b5\": \"Scene Left Half\",\n      \"    \\\"0f9c623efae8e91f904f0b8f5364a4fe\\\": \\\"\\\",\": \"Scene Full Screen\",\n      \"    \\\"0434816d47916724248404867aeca064\\\": \\\"\\\",\": \"Scene Left Half\",\n      \"993904a8df1ddc51cc1bbb7ee87f8cad\": \"Scene Camera_lower_left\",\n      \"9020d96b039d074f4213cc9fd2dda375\": \"Scene Over the Shoulder round\",\n      \"d2d8b8b97cc62a680151ffbcdcfd7aff\": \"Scene Over the Shoulder\",\n      \"07e7afbcaa4341c44e5c756d74cf1ada\": \"Scene Full Screen\",\n      \"446ed9587ace9f292e054051d865eb58\": \"Scene Slides over Camera\",\n      \"ef1f9f9580026744b9b5b15cac438944\": \"Scene Over the Shoulder\",\n      \"61e7453562b301297994603be10b61e2\": \"Scene Full Screen\",\n      \"6feefa85c8d21ce09758d0de01b4b6e6\": \"Scene Left Half\",\n      \"439aa00346f2cb019cdaa2ae92cf994f\": \"Scene Full Screen\",\n      \"234630ccd0d9cba454c725b24e243dc3\": \"Scene Full Screen\",\n      \"655b2b68e95df103d8d5633bd9f5ed13\": \"Scene Full Screen\",\n      \"c3dc484178939d752363ba2431d1fbb5\": \"Scene Full Screen\",\n      \"4db595e5c7c496741f815d28d64620cf\": \"Scene Full Screen\",\n      \"d84c4d25d1e7d7c8c88ac5a3e94c87d2\": \"Scene Full Screen\",\n      \"17a629b1dc3e85a86b4f6d9483734e91\": \"Scene Left Half\",\n      \"9a8202c2384dc5f720708d4f71bb813b\": \"Scene Left Half\",\n      \"fc4bdf7cdade7e148024148357c3fa5c\": \"Scene Full Screen\",\n      \"c7e3f7e5d4078b88f39d6da8ede9f48a\": \"Scene Full Screen\",\n      \"cd545e4696a3120bb29aaf1ad30074fa\": \"Scene Full Screen\",\n      \"frag-5,1,0\": \"Scene Camera_lower_left\",\n      \"frag-5,1,1\": \"Scene Over the Shoulder\"\n    }\n  }\n}"
