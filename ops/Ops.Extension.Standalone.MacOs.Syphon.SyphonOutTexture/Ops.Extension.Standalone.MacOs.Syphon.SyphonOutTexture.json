    "summary": "Publishes any intermediate WebGL texture to macOS Syphon with zero render-thread stalls via WebGL2 PBOs, Metal, and Apple IOSurface.",
    "docs": {
        "ports": [
            {
                "name": "Render",
                "text": "Trigger input to process and publish the connected texture frame."
            },
            {
                "name": "Texture",
                "text": "The intermediate Cables WebGL texture (e.g. from an FBO, shader pass, generator, or video) to publish to Syphon."
            },
            {
                "name": "Active",
                "text": "Enables or disables the Syphon server."
            },
            {
                "name": "Server Name",
                "text": "Broadcast name of the Syphon server (visible in OBS, Resolume, MadMapper, TouchDesigner)."
            },
            {
                "name": "Is Publishing",
                "text": "True when the Syphon server is running."
            },
            {
                "name": "Status",
                "text": "Human-readable telemetry status."
            },
            {
                "name": "Width",
                "text": "Pixel width of the published texture."
            },
            {
                "name": "Height",
                "text": "Pixel height of the published texture."
            },
            {
                "name": "FPS",
                "text": "Actual output streaming frame rate."
            },
            {
                "name": "Has Clients",
                "text": "True if an external application is currently subscribed to this Syphon stream."
            },
            {
                "name": "IOSurface ID",
                "text": "Internal Apple IOSurface ID."
            }
        ]
    },
    "isReleased": true
