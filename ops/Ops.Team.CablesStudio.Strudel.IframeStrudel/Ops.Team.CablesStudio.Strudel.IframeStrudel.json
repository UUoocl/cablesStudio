    "summary": "AGPL-3.0 / MIT Compatible Embedded Iframe Strudel REPL Operator for Cables.gl. Mounts an isolated DOM iframe element with zero-copy createImageBitmap GPU texture generation, WebAudio routing, live code editing, and BroadcastChannel telemetry",
    "docs": {
        "ports": [
            {
                "name": "Show Iframe",
                "text": "Toggle visibility of the embedded HTML iframe element in the Cables canvas UI."
            },
            {
                "name": "Play / Stop",
                "text": "Checkbox toggle to start (play) or stop (hush) Strudel pattern evaluation."
            },
            {
                "name": "Width",
                "text": "Pixel width of the iframe container."
            },
            {
                "name": "Height",
                "text": "Pixel height of the iframe container."
            },
            {
                "name": "Iframe Position",
                "text": "Position mode for the iframe element on the DOM overlay (Top-Right, Top-Left, Bottom-Right, Bottom-Left, Center, Hidden)."
            },
            {
                "name": "Opacity",
                "text": "Opacity of the iframe DOM overlay (0.0 - 1.0)."
            },
            {
                "name": "Strudel CSS Variables",
                "text": "Custom CSS variable definitions for editor theme customization."
            },
            {
                "name": "Pattern Code",
                "text": "Strudel live coding pattern string to evaluate."
            },
            {
                "name": "Volume",
                "text": "Master volume float for the operator output GainNode."
            },
            {
                "name": "Flip Y",
                "text": "Flips the Y axis during WebGL texture upload."
            },
            {
                "name": "Is Active",
                "text": "Outputs true when the iframe is mounted and running."
            },
            {
                "name": "Iframe Element",
                "text": "Reference to the DOM HTMLIFrameElement."
            },
            {
                "name": "Image Bitmap",
                "text": "Outputs latest zero-copy ImageBitmap frame captured from the iframe canvas."
            },
            {
                "name": "Texture",
                "text": "Native CGL.Texture object for direct WebGL rendering in Cables shaders."
            },
            {
                "name": "Texture Updated",
                "text": "Trigger fired whenever a new GPU texture frame is uploaded."
            },
            {
                "name": "Audio Node",
                "text": "WebAudio GainNode forwarding Strudel's audio output."
            },
            {
                "name": "Active Notes",
                "text": "Array of currently sounding active note objects."
            },
            {
                "name": "Active MIDI Notes",
                "text": "Array of active MIDI note numbers (e.g. [48, 52])."
            },
            {
                "name": "Active Note Names",
                "text": "Array of active note names (e.g. ['C3', 'E3'])."
            },
            {
                "name": "On Note Event",
                "text": "Trigger fired when a note event occurs."
            }
        ]
    },
