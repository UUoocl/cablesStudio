    "summary": "Taps directly into Electron's macOS native view layer (CALayer / IOSurface) with zero CPU copies and publishes to Syphon on Apple Silicon.",
    "docs": {
        "ports": [
            {
                "name": "Active",
                "text": "Enables or disables the Syphon server."
            },
            {
                "name": "Render",
                "text": "Trigger input to publish a frame on demand (used when Continuous DisplayLink is disabled)."
            },
            {
                "name": "Continuous DisplayLink",
                "text": "When true, runs a hardware-synchronized CVDisplayLink loop (60/120Hz) completely decoupled from the JavaScript event loop."
            },
            {
                "name": "Server Name",
                "text": "The broadcast name of the Syphon server."
            },
            {
                "name": "Crop To Patch Canvas",
                "text": "Automatically detects the Cables WebGL canvas DOM bounding rect (scaled by devicePixelRatio) and crops the output so only the patch canvas is published."
            },
            {
                "name": "Custom Crop",
                "text": "Enables manual pixel coordinate cropping."
            },
            {
                "name": "Crop X",
                "text": "Horizontal offset in backing store pixels."
            },
            {
                "name": "Crop Y",
                "text": "Vertical offset in backing store pixels."
            },
            {
                "name": "Crop Width",
                "text": "Width in backing store pixels."
            },
            {
                "name": "Crop Height",
                "text": "Height in backing store pixels."
            },
            {
                "name": "Is Publishing",
                "text": "True when the Syphon server is actively running."
            },
            {
                "name": "Status",
                "text": "Human-readable status and telemetry message."
            },
            {
                "name": "Surface Width",
                "text": "Width of the native composite surface in physical pixels."
            },
            {
                "name": "Surface Height",
                "text": "Height of the native composite surface in physical pixels."
            },
            {
                "name": "FPS",
                "text": "Actual streaming frame rate."
            },
            {
                "name": "IOSurface ID",
                "text": "Apple IOSurface ID of the active Chromium composite."
            },
            {
                "name": "Has Clients",
                "text": "True if an external Syphon client (OBS, Resolume, MadMapper, TouchDesigner) is currently subscribed to this stream."
            }
        ]
    },
    "isReleased": true
