    "summary": "Wraps all standard events and requests of the OBS Browser Source API (window.obsstudio) for deep integration with OBS.",
    "docs": {
        "ports": [
            {
                "name": "Update Status",
                "text": "Triggers a full query of all current OBS status information (scenes, transitions, streaming/recording states, etc.)."
            },
            {
                "name": "Save Replay Buffer",
                "text": "Tells OBS to save the current replay buffer. Requires BASIC control level permissions."
            },
            {
                "name": "Start Replay Buffer",
                "text": "Starts the replay buffer. Requires ADVANCED control level permissions."
            },
            {
                "name": "Stop Replay Buffer",
                "text": "Stops the replay buffer. Requires ADVANCED control level permissions."
            },
            {
                "name": "Start Streaming",
                "text": "Starts live streaming. Requires ALL control level permissions."
            },
            {
                "name": "Stop Streaming",
                "text": "Stops live streaming. Requires ALL control level permissions."
            },
            {
                "name": "Start Recording",
                "text": "Starts local video recording. Requires ALL control level permissions."
            },
            {
                "name": "Stop Recording",
                "text": "Stops local video recording. Requires ALL control level permissions."
            },
            {
                "name": "Pause Recording",
                "text": "Pauses local recording if active. Requires ALL control level permissions."
            },
            {
                "name": "Unpause Recording",
                "text": "Resumes local recording if paused. Requires ALL control level permissions."
            },
            {
                "name": "Start Virtualcam",
                "text": "Starts the virtual camera output. Requires ALL control level permissions."
            },
            {
                "name": "Stop Virtualcam",
                "text": "Stops the virtual camera output. Requires ALL control level permissions."
            },
            {
                "name": "Set Scene",
                "text": "Switches the active scene in OBS to the scene specified in the Scene Name input port. Requires ADVANCED control level permissions."
            },
            {
                "name": "Scene Name",
                "text": "The name of the scene to switch to."
            },
            {
                "name": "Set Transition",
                "text": "Switches the active scene transition to the transition specified in the Transition Name input port. Requires ADVANCED control level permissions."
            },
            {
                "name": "Transition Name",
                "text": "The name of the transition to switch to."
            },
            {
                "name": "Custom Events",
                "text": "A comma or space-separated list of custom events (e.g. emitted from obs-websocket) to register and listen to."
            },
            {
                "name": "Is OBS Browser Source",
                "text": "Outputs true if running inside OBS CEF."
            },
            {
                "name": "Plugin Version",
                "text": "The version of the OBS Browser source plugin."
            },
            {
                "name": "Control Level",
                "text": "The permission level granted to this page: 0 (NONE), 1 (READ_OBS), 2 (READ_USER), 3 (BASIC), 4 (ADVANCED), 5 (ALL)."
            },
            {
                "name": "Recording",
                "text": "Outputs true if OBS is currently recording."
            },
            {
                "name": "Recording Paused",
                "text": "Outputs true if OBS recording is currently paused."
            },
            {
                "name": "Recording Paused Event",
                "text": "Fires when OBS recording is paused."
            },
            {
                "name": "Streaming",
                "text": "Outputs true if OBS is currently live streaming."
            },
            {
                "name": "Replay Buffer",
                "text": "Outputs true if the Replay Buffer is currently running."
            },
            {
                "name": "Virtual Cam",
                "text": "Outputs true if Virtual Camera is active."
            },
            {
                "name": "Current Scene Name",
                "text": "The name of the currently active scene."
            },
            {
                "name": "Current Scene Width",
                "text": "Width of the current scene in pixels."
            },
            {
                "name": "Current Scene Height",
                "text": "Height of the current scene in pixels."
            },
            {
                "name": "Scenes",
                "text": "An array of all scene names configured in OBS."
            },
            {
                "name": "Transitions",
                "text": "An array of all transition names configured in OBS."
            },
            {
                "name": "Current Transition",
                "text": "The name of the currently active transition."
            },
            {
                "name": "On Status Updated",
                "text": "Fires when status query callbacks complete."
            },
            {
                "name": "Error",
                "text": "Holds permission or connection failure messages."
            },
            {
                "name": "Custom Event Received",
                "text": "Fires when any registered custom event is received."
            },
            {
                "name": "Custom Event Name",
                "text": "Name of the received custom event."
            },
            {
                "name": "Custom Event Detail",
                "text": "The detail object/payload from the custom event."
            }
        ]
    }
}
