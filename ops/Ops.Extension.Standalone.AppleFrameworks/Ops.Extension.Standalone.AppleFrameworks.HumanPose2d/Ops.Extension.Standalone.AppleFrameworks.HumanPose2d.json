    "summary": "Tracks 2D human body pose joints and coordinates in real-time from an input WebGL texture using macOS Apple Vision neural frameworks directly in memory.",
    "docs": {
        "ports": [
            {
                "name": "Active",
                "text": "Starts or stops the native HumanPose2d tracking engine."
            },
            {
                "name": "Render",
                "text": "Trigger render loop to process the incoming texture."
            },
            {
                "name": "Texture",
                "text": "WebGL Texture containing the human subject to track."
            },
            {
                "name": "Min Confidence",
                "text": "Ignore keypoints with confidence lower than this threshold."
            },
            {
                "name": "Max Dimension",
                "text": "The maximum dimension to resize the input texture to before passing it to the neural engine."
            },
            {
                "name": "ROI X",
                "text": "Region of interest X offset (0.0 - 1.0)."
            },
            {
                "name": "ROI Y",
                "text": "Region of interest Y offset (0.0 - 1.0)."
            },
            {
                "name": "ROI Width",
                "text": "Region of interest width (0.0 - 1.0)."
            },
            {
                "name": "ROI Height",
                "text": "Region of interest height (0.0 - 1.0)."
            },
            {
                "name": "Poses Array",
                "text": "An array of detected body poses containing tracked joint names, normalized x/y coordinates (mapped to top-left origin), and confidence levels."
            },
            {
                "name": "Detected Poses",
                "text": "Total number of human body pose instances currently tracked in the active frame."
            },
            {
                "name": "On Poses Detected",
                "text": "Trigger fired every time a new set of pose landmarks is received."
            },
            {
                "name": "Running",
                "text": "True if the native pose tracking engine is active."
            },
