    "summary": "Monitors inputs (buttons, joysticks, triggers) and controls rumble on the 8BitDo Lite SE 2.4G Xbox Controller natively using macOS IOKit in memory.",
    "docs": {
        "ports": [
            {
                "name": "Active",
                "text": "Starts or stops the native IOKit controller interface listener."
            },
            {
                "name": "Rumble Left",
                "text": "Controls heavy body vibration motor strength (0.0 to 1.0)."
            },
            {
                "name": "Rumble Right",
                "text": "Controls light body vibration motor strength (0.0 to 1.0)."
            },
            {
                "name": "Rumble Left Trigger",
                "text": "Controls left impulse trigger vibration motor strength (0.0 to 1.0)."
            },
            {
                "name": "Rumble Right Trigger",
                "text": "Controls right impulse trigger vibration motor strength (0.0 to 1.0)."
            },
            {
                "name": "Trigger Rumble",
                "text": "Fires a command immediately writing the current rumble settings to the controller."
            },
            {
                "name": "Send Rumble on Change",
                "text": "Automatically writes rumble settings to the controller whenever any input value changes."
            },
            {
                "name": "On Event",
                "text": "Fires a trigger when any state changes on the controller."
            },
            {
                "name": "Is Connected",
                "text": "True if the controller is connected and successfully claimed."
            },
            {
                "name": "Status",
                "text": "Human-readable status of the controller connection."
            }
        ]
    }
