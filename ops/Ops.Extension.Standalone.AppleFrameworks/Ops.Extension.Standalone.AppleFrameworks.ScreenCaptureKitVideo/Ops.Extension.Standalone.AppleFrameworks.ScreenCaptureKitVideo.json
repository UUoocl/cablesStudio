    "summary": "Captures macOS displays or specific application windows natively using Apple's high-performance ScreenCaptureKit framework.",
    "docs": {
        "ports": [
            {
                "name": "Render",
                "text": "Triggers the frame upload loop to pull the latest frame onto the WebGL texture."
            },
            {
                "name": "Active",
                "text": "True to start the capture stream, false to stop it."
            },
            {
                "name": "Capture Type",
                "text": "Choose to capture a display (Screen Capture) or a specific application window (Window Capture)."
            },
            {
                "name": "Source",
                "text": "Select the target screen or window from the dynamically populated list."
            },
            {
                "name": "Output Width",
                "text": "Target capture width. ScreenCaptureKit will natively scale the captured frame to this size."
            },
            {
                "name": "Output Height",
                "text": "Target capture height. ScreenCaptureKit will natively scale the captured frame to this size."
            },
            {
                "name": "Refresh",
                "text": "Manually triggers a query to update the available screens and windows lists."
            },
            {
                "name": "Texture",
                "text": "Outputs the captured video stream as a WebGL Texture."
            },
            {
                "name": "Next",
                "text": "Outward trigger cascading rendering loop."
            },
            {
                "name": "Width",
                "text": "Actual width of the generated texture."
            },
            {
                "name": "Height",
                "text": "Actual height of the generated texture."
            },
            {
                "name": "Status",
                "text": "Text status indicating capture states: Stopped, Capturing, Permission Denied, or Error."
            }
        ]
    }
