            },
            {
                "name": "On Event",
                "text": "Fires when any state, button, jog, or shuttle update arrives."
            },
            {
                "name": "Status",
                "text": "Connection status string."
            },
            {
                "name": "Running",
                "text": "True if active."
            },
            {
                "name": "Jog Value",
                "text": "Current position of the inner jog wheel."
            },
            {
                "name": "Jog Delta",
                "text": "Jog movement delta since last tick."
            },
            {
                "name": "Jog Turned",
                "text": "Fires when the jog wheel rotates."
            },
            {
                "name": "Shuttle Value",
                "text": "Current position of the outer spring-loaded shuttle ring (-7 to 7)."
            },
            {
                "name": "Shuttle Moved",
                "text": "Fires when the shuttle ring is deflected."
            },
            {
                "name": "Button Index",
                "text": "Index of the button that triggered a press/release action (0-4)."
            },
            {
                "name": "Button Pressed",
                "text": "True if the button is pressed, false if released."
            },
            {
                "name": "Button Event",
                "text": "Fires when a button state changes."
            }
