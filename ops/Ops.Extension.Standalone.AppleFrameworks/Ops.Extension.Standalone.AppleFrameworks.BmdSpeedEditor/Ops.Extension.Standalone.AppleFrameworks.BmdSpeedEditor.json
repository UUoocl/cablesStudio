    "docs": {
        "ports": [
            {
                "name": "Active",
                "text": "Starts or stops the native Speed Editor listener."
            },
            {
                "name": "LEDs State",
                "text": "Object dictionary of button LED keys and their active state (e.g. `{\"CUT\": true, \"JOG\": false}`)."
            },
            {
                "name": "Button LEDs",
                "text": "Raw bitfield for the buttons LEDs."
            },
            {
                "name": "Jog LEDs",
                "text": "Raw bitfield for the jog LEDs (Jog, Shuttle, Scroll)."
            },
            {
                "name": "Jog Mode",
                "text": "Selects the jog wheel mode (0 = relative ticks, 1 = absolute mode, etc)."
            },
            {
                "name": "On Event",
                "text": "Fires when any state, key, jog, or battery update arrives."
            },
            {
                "name": "Status",
                "text": "Connection status string."
            },
            {
                "name": "Running",
                "text": "True if active."
            },
            {
                "name": "Keys Pressed",
                "text": "Array of raw key codes currently held down."
            },
            {
                "name": "Key Names",
                "text": "Array of friendly names of keys currently held down."
            },
            {
                "name": "Last Key",
                "text": "Name of the last key that triggered a press/release action."
            },
            {
                "name": "Last Key Pressed",
                "text": "True if the last key event was a press, false if release."
            },
            {
                "name": "Key Event",
                "text": "Fires when a key is pressed or released."
            },
            {
                "name": "Jog Value",
                "text": "Current position of the jog wheel."
            },
            {
                "name": "Jog Delta",
                "text": "Jog movement delta since last tick."
            },
            {
                "name": "Jog Turned",
                "text": "Fires when the jog wheel rotates."
            },
            {
                "name": "Battery Level",
                "text": "Battery charge level (0-100)."
            },
            {
                "name": "Charging",
                "text": "True if the device is plugged in and charging."
            }
        ]
    }
